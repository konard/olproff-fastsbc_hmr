# IP matching. Oracle expresses address tests with the ip / ip-mask / ip-range
# match types; in this compiler match-value is always a regular expression and
# `match-val-type ip` flags the value as an address literal. The patterns below
# match RFC 1918 ranges (10.0.0.0/8, 192.168.0.0/16) via regex.
sip-manipulation IpMatching
        header-rule
                name         rejectPrivate10
                header-name  Contact
                action       reject
                comparison-type  pattern-rule
                match-value  @10\.\d{1,3}\.\d{1,3}\.\d{1,3}

        header-rule
                name         tagRfc1918
                header-name  X-Net-Class
                action       add
                new-value    private

        header-rule
                name         maskPrivateVia
                header-name  Via
                action       manipulate
                element-rule
                        name    hideHost
                        type    uri-host
                        action  replace
                        match-val-type  ip
                        match-value  192\.168\.\d{1,3}\.\d{1,3}
                        new-value    $LOCAL_IP
